  emailEnabled      Boolean  @default(true) @map("email_enabled")
  smsEnabled        Boolean  @default(false) @map("sms_enabled")
  pushEnabled       Boolean  @default(false) @map("push_enabled")
  remindersEnabled  Boolean  @default(true) @map("reminders_enabled")
  marketingEnabled  Boolean  @default(false) @map("marketing_enabled")
  receiptsEnabled   Boolean  @default(true) @map("receipts_enabled")
  /// Quiet hours in user local time (HH:mm); null = no quiet hours.
  quietHoursStart   String?  @map("quiet_hours_start")
  quietHoursEnd     String?  @map("quiet_hours_end")
  timezone          String   @default("UTC")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@map("notification_preferences")
}

model SmsConsent {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  phone       String
  consentedAt DateTime  @map("consented_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip          String?
  userAgent   String?   @map("user_agent")
  source      String    @default("portal")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sms_consents")
}

model PushSubscription {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId, revokedAt])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// Wave 16 — GDPR DSR audit (T-077)
// ---------------------------------------------------------------------------

enum DsrRequestType {
  EXPORT
  ERASE
}

enum DsrRequestStatus {
  PENDING
  COMPLETED
  FAILED
}

model DsrRequest {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  type              DsrRequestType
  status            DsrRequestStatus @default(PENDING)
  requestedAt       DateTime         @default(now()) @map("requested_at") @db.Timestamptz(3)
  completedAt       DateTime?        @map("completed_at") @db.Timestamptz(3)
  downloadTokenHash String?          @map("download_token_hash")
  downloadExpiresAt DateTime?        @map("download_expires_at") @db.Timestamptz(3)
  resultPayload     Json?            @map("result_payload")
  metadata          Json             @default("{}")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, status])
  @@index([downloadTokenHash])
  @@map("dsr_requests")
}

