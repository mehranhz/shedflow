{
  "name": "@shedflow/shared",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ssrf": {
      "types": "./dist/ssrf.d.ts",
      "import": "./dist/ssrf.js",
      "require": "./dist/ssrf.js",
      "default": "./dist/ssrf.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "require": "./dist/webhooks.js",
      "default": "./dist/webhooks.js"
    },
    "./envelope": {
      "types": "./dist/envelope.d.ts",
      "import": "./dist/envelope.js",
      "require": "./dist/envelope.js",
      "default": "./dist/envelope.js"
    },
    "./internalAuth": {
      "types": "./dist/internalAuth.d.ts",
      "import": "./dist/internalAuth.js",
      "require": "./dist/internalAuth.js",
      "default": "./dist/internalAuth.js"
    },
    "./openapi/v1.yaml": "./openapi/v1.yaml"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@shedflow/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  }
}
