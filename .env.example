# Secret used to sign JWT access tokens. Generate one with `openssl rand -hex 32`.
JWT_SECRET=change-me-in-development

# 32-byte hex key for encrypting webhook endpoint secrets at rest (T-033).
# Generate with `openssl rand -hex 32`. Falls back to a hash of JWT_SECRET in dev if unset.
TOKEN_ENCRYPTION_KEY=

# Shared HMAC secret for api ↔ worker `/internal/*` calls. Same value in both apps.
INTERNAL_API_SECRET=change-me-in-development

# API HTTP port. The Next.js client stays on 3000 by default.
PORT=3001

# Dashboard origin allowed by API CORS.
APP_URL=http://localhost:3000

# NextAuth (Auth.js). Required by the client; generate with `openssl rand -hex 32`.
AUTH_SECRET=change-me-in-development
AUTH_URL=http://localhost:3000
API_URL=http://localhost:3001
BILLING_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string used by Prisma Client.
# Compose maps host 5533 → container 5432 (see docker-compose.yml).
DATABASE_URL=postgresql://shedflow:shedflow@localhost:5533/shedflow?schema=public

# Non-pooled URL for Prisma migrations. Same as DATABASE_URL locally.
DIRECT_DATABASE_URL=postgresql://shedflow:shedflow@localhost:5533/shedflow?schema=public

# Separate database used by `pnpm test:e2e` so end-to-end runs never touch dev data.
TEST_DATABASE_URL=postgresql://shedflow:shedflow@localhost:5533/shedflow_test?schema=public

# Optional. Only needed when the migration user cannot create databases itself,
# which is the case on some hosted Postgres providers.
# SHADOW_DATABASE_URL=

# Docker Compose profiles. `core` = postgres; `observability` = Prometheus/Grafana/…
# Omit or override to start a subset: `docker compose --profile core up -d`.
COMPOSE_PROFILES=core,observability

# Billing → API internal calls (confirm/expire after webhooks).
# API_URL is already set above for the client; billing uses the same value.

# Stripe test-mode placeholders for apps/billing. Replace with Dashboard test keys locally.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PLATFORM_FEE_BPS=200
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=

# Worker email (T-025). Without RESEND_API_KEY the worker logs HTML and still
# records notification_logs as SENT (never call real Resend in CI).
EMAIL_FROM=SchedFlow <notifications@mail.schedflow.com>
# RESEND_API_KEY=
WORKER_PORT=3003

# Worker → API HMAC calls for booking.expire / confirm (T-026).
# API_URL=http://localhost:3001

# --- Completeness (mvp/01 §7) — optional / future integrations ---
NODE_ENV=development
LOG_LEVEL=info
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d
# Alias used by some docs; apps currently read TOKEN_ENCRYPTION_KEY above.
# ENCRYPTION_KEY= (32-byte base64; required for calendar token encryption in prod)
BILLING_PORT=3002
# NEXT_PUBLIC_EMBED_URL=http://localhost:3000
# NEXT_PUBLIC_EMBED_SCRIPT_URL=http://localhost:5174/embed.js
# FLAGS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_WEBHOOK_URL=https://api.example.com/webhooks/google-calendar
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT=common
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OUTBOX_BACKOFF_MS=1000
# OUTBOX_MAX_ATTEMPTS=10
# OUTBOX_RELAY_INTERVAL_MS=1000
# OUTBOX_POLLING_INTERVAL_SECONDS=1
