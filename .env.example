# Secret used to sign JWT access tokens. Generate one with `openssl rand -hex 32`.
JWT_SECRET=change-me-in-development

# Port the HTTP server listens on.
PORT=3000

# PostgreSQL connection string used by Prisma Client and the Prisma CLI.
DATABASE_URL=postgresql://shedflow:shedflow@localhost:5432/shedflow?schema=public

# Separate database used by `pnpm test:e2e` so end-to-end runs never touch dev data.
TEST_DATABASE_URL=postgresql://shedflow:shedflow@localhost:5432/shedflow_test?schema=public

# Optional. Only needed when the migration user cannot create databases itself,
# which is the case on some hosted Postgres providers.
# SHADOW_DATABASE_URL=
