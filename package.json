{
  "name": "shedflow",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "db:generate": "pnpm --filter @shedflow/api db:generate",
    "db:migrate": "pnpm --filter @shedflow/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @shedflow/api db:migrate:deploy",
    "db:reset": "pnpm --filter @shedflow/api db:reset",
    "db:studio": "pnpm --filter @shedflow/api db:studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.6"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
